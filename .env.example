# Docker image/channel. Pin a numbered release for reproducible deployments.
BRIDGE_IMAGE_TAG=beta
BRIDGE_PORT=8001

AIRDCPP_URL=http://host.docker.internal:5600
AIRDCPP_USER=admin
AIRDCPP_PASS=change-me

# Optional AirDC++ Web UI URL. Enables clickable result-folder links.
AIRDCPP_WEB_URL=
# URL used by Radarr/Sonarr to fetch results from this bridge.
PUBLIC_URL=http://192.168.1.10:8001

BRIDGE_API_KEY=change-me-to-a-long-random-value
BRIDGE_USERNAME=arr
BRIDGE_PASSWORD=change-me-to-a-long-random-value

TMDB_API_KEY=
SAVE_PATH=/downloads
DOWNLOAD_CATEGORIES=radarr,sonarr,radarr4k,sonarr4k
COMPLETED_RATIO=1.5
ALLOW_FILE_DELETE=false

AIRDCPP_MAX_ACTIVE_SEARCHES=1
SEARCH_TIMEOUT=10
SEARCH_POLL_INTERVAL=1
SEARCH_STABLE_CYCLES=2
SEARCH_MAX_RESULTS=1000
SEARCH_CACHE_TTL=300
SEARCH_NEGATIVE_CACHE_TTL=30
SEARCH_CACHE_SIZE=256
SEARCH_MIN_ACCEPTED_RESULTS=5
SEARCH_MAX_VARIANTS=4
SEASON_INSPECT_MAX=10
SEASON_INSPECT_TIMEOUT=5
LOG_LEVEL=INFO

# Never enable on an Internet-facing or untrusted network.
ALLOW_INSECURE=false
