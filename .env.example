AIRDCPP_URL=http://host.docker.internal:5600
AIRDCPP_USER=admin
AIRDCPP_PASS=change-me
# URL pública del Web UI. Déjala vacía para desactivar los enlaces navegables.
AIRDCPP_WEB_URL=

BRIDGE_API_KEY=generate-a-long-random-value
BRIDGE_USERNAME=arr
BRIDGE_PASSWORD=generate-a-long-random-value

TMDB_API_KEY=
SAVE_PATH=/downloads
DOWNLOAD_CATEGORIES=radarr,sonarr,radarr4k,sonarr4k
# URL pública del bridge, necesaria cuando los ARR acceden por un hostname interno.
PUBLIC_URL=
COMPLETED_RATIO=1.5
ALLOW_FILE_DELETE=false
AIRDCPP_MAX_ACTIVE_SEARCHES=1
SEARCH_TIMEOUT=10
SEARCH_CACHE_TTL=300
SEARCH_MIN_ACCEPTED_RESULTS=5
SEARCH_MAX_VARIANTS=4
LOG_LEVEL=INFO
